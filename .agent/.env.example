# Local Environment Config Template
# Copy this to .env and fill in your values, OR just run /validate-workflows
# to auto-generate everything.

# === Auto-Detected Values (filled by Pre-Flight) ===
PROJECT_ROOT=
PHP_PATH=
LOCALHOST_URL=

# === Issue Tracker (auto-detected from git remote) ===
ISSUE_PLATFORM=
REPO_OWNER=
REPO_NAME=
GITEA_URL=
GITEA_API=

# === Tokens ===
# Gitea: generate at your Gitea instance → Settings → Applications
GITEA_TOKEN=

# GitHub: NOT needed — uses MCP server (configured in IDE settings)
