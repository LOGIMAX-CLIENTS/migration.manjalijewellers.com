name: "🚀 Deploy"

# ─────────────────────────────────────────────────────────────────────────────
# Auto-generated by Logimax DevOps Tool
# Client: etail_development_src
# Staging: STAGING (git_pull)
# Production: PRODUCTION (symlink)
# ─────────────────────────────────────────────────────────────────────────────

on:
  push:
    branches:
      - STAGING
      - PRODUCTION
  workflow_dispatch:
    inputs:
      environment:
        description: 'Target environment'
        required: true
        default: 'staging'
        type: choice
        options:
          - staging
          - production
      deployment_id:
        description: 'Internal Deployment ID (from DevOps dashboard)'
        required: false

jobs:
  # ===========================================================================
  # STAGING DEPLOYMENT
  # ===========================================================================
  deploy-staging:
    if: >-
      github.ref == 'refs/heads/STAGING'
      || (github.event_name == 'workflow_dispatch' && inputs.environment == 'staging')
    runs-on: ubuntu-latest
    steps:
      - name: 📡 Trigger Staging Deployment
        run: |
          curl -s -X POST "${{ secrets.WEBHOOK_URL }}" \
            -H "Content-Type: application/json" \
            -d "{\\"client_id\\": \\"etail_development_src\\", \\"environment\\": \\"staging\\", \\"deploy_mode\\": \\"git_pull\\", \\"maintenance_mode\\": false, \\"branch\\": \\"STAGING\\", \\"commit_sha\\": \\"${{ github.sha }}\\", \\"deployment_id\\": \\"${{ github.event.inputs.deployment_id || '' }}\\", \\"trigger\\": \\"${{ github.event_name }}\\", \\"secret\\": \\"${{ secrets.WEBHOOK_SECRET }}\\"}"

  # ===========================================================================
  # PRODUCTION DEPLOYMENT
  # ===========================================================================
  deploy-production:
    if: >-
      github.ref == 'refs/heads/PRODUCTION'
      || (github.event_name == 'workflow_dispatch' && inputs.environment == 'production')
    runs-on: ubuntu-latest
    steps:
      - name: 📡 Trigger Production Deployment
        run: |
          curl -s -X POST "${{ secrets.WEBHOOK_URL }}" \
            -H "Content-Type: application/json" \
            -d "{\\"client_id\\": \\"etail_development_src\\", \\"environment\\": \\"production\\", \\"deploy_mode\\": \\"symlink\\", \\"maintenance_mode\\": true, \\"branch\\": \\"PRODUCTION\\", \\"commit_sha\\": \\"${{ github.sha }}\\", \\"deployment_id\\": \\"${{ github.event.inputs.deployment_id || '' }}\\", \\"trigger\\": \\"${{ github.event_name }}\\", \\"secret\\": \\"${{ secrets.WEBHOOK_SECRET }}\\"}"

  # ===========================================================================
  # REPORT STATUS TO DEVOPS DASHBOARD
  # ===========================================================================
  report-status:
    needs: [deploy-staging, deploy-production]
    if: always() && !cancelled()
    runs-on: ubuntu-latest
    steps:
      - name: 📡 Report to DevOps Dashboard
        env:
          STAGING_REF: refs/heads/STAGING
        run: |
          STATUS="success"
          DEPLOY_ENV="staging"
          if [ "${{ github.ref }}" != "\$STAGING_REF" ]; then
            DEPLOY_ENV="production"
          fi
          if [ "${{ contains(needs.*.result, 'failure') }}" == "true" ]; then
            STATUS="failed"
          fi
          curl -s -X POST "${{ secrets.SYNC_STATUS_URL }}" \
            -H "Content-Type: application/json" \
            -H "X-Webhook-Secret: ${{ secrets.WEBHOOK_SECRET }}" \
            -d "{\\"type\\": \\"deployment\\", \\"client_id\\": \\"etail_development_src\\", \\"environment\\": \\"\$DEPLOY_ENV\\", \\"status\\": \\"\$STATUS\\", \\"commit_sha\\": \\"${{ github.sha }}\\", \\"trigger\\": \\"${{ github.event_name }}\\", \\"deployment_id\\": \\"${{ github.event.inputs.deployment_id || '' }}\\"}" || true
